# ainovel 腾讯轻量云首次部署环境模板
# 用法：cp .env.example .env 后按需填写；LLM key 全留空 = 应用可启动，模型调用在后台任务里报错，页面功能正常。
# 敏感值不要提交进 git；真实 .env 只存在于部署机 /opt/ai-novel/.env（0600）。

# --- 数据库（SQLite，单文件，启动自迁移建库） ---
AI_NOVEL_DATABASE_MODE=sqlite
DATABASE_URL=file:/data/ai-novel.db

# --- 数据/日志/存储统一根（compose 挂 ./data:/data） ---
AI_NOVEL_APP_DATA_DIR=/data

# --- 服务 ---
PORT=3000
API_JSON_LIMIT=2mb
NOVEL_SNAPSHOT_RETENTION_COUNT=10

# --- Node 内存（独享 4G 单机，比 pxed 共享宿主宽松；2g cgroup 顶） ---
NODE_OPTIONS=--max-old-space-size=1536
MALLOC_ARENA_MAX=2

# --- RAG：首次精简部署关掉（无 qdrant 容器）；要开时再起 infra/docker-compose.qdrant.yml ---
RAG_ENABLED=false

# --- LLM keys（全部留空，用户后续自行填写） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
SILICONFLOW_API_KEY=
ANTHROPIC_API_KEY=
